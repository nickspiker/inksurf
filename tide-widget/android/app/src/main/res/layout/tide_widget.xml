<?xml version="1.0" encoding="utf-8"?>
<!-- The bitmap is rendered at the widget's exact pixel size, so fitXY is a 1:1 no-op; it only resamples if the launcher's reported size was off. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tide_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />
</FrameLayout>
